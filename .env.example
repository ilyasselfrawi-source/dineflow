# DineFlow Environment Variables
# Copy this file to .env.local and fill in your values

# ── Database ──────────────────────────────────────────────────────────
# SQLite (local development - no setup needed)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production - uncomment and fill)
# DATABASE_URL="postgresql://user:password@localhost:5432/dineflow?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Your domain (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
